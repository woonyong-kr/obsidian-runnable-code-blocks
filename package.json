{
  "name": "runnable-code-blocks",
  "version": "0.6.0",
  "description": "Run 24 Markdown code-block fences, including React JSX and TSX, in Obsidian and static websites.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production && node local-runner/esbuild.config.mjs",
    "demo:build": "node demo/scripts/build.mjs",
    "demo:capture": "node demo/scripts/capture.mjs",
    "demo:serve": "node scripts/serve-demo.mjs",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit && eslint src tests site local-runner/src local-runner/tests && node --check scripts/verify-release.mjs",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke:kotlin": "tsx scripts/smoke-remote.ts kotlin",
    "smoke:remote": "tsx scripts/smoke-remote.ts",
    "verify:release": "node scripts/verify-release.mjs",
    "verify": "npm run check && npm run knip && npm test && npm run build && npm run verify:release && npm run test:e2e && npm pack --dry-run"
  },
  "knip": {
    "entry": [
      "local-runner/src/cli.ts"
    ],
    "ignoreBinaries": [
      "ffmpeg",
      "ffprobe"
    ]
  },
  "overrides": {
    "@codemirror/lint": "6.9.0"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "code-runner",
    "code-block",
    "learning",
    "wiki",
    "kotlin",
    "javascript",
    "polyglot"
  ],
  "author": "Woonyong Choi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-kr/obsidian-runnable-code-blocks.git"
  },
  "homepage": "https://woonyong-kr.github.io/obsidian-runnable-code-blocks/",
  "bugs": {
    "url": "https://github.com/woonyong-kr/obsidian-runnable-code-blocks/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "main.js",
    "manifest.json",
    "styles.css",
    "README.md",
    "LICENSE",
    "versions.json"
  ],
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.1",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.9",
    "eslint": "^10.0.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^20.11.6",
    "knip": "^6.33.0",
    "obsidian": "^1.13.1",
    "sucrase": "^3.35.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
